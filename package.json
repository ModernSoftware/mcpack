{
  "name": "@modernsoftware/mcpack",
  "version": "0.1.0-alpha.1",
  "description": "Native MCP capabilities backed by persistent runtime workers",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "mcpack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "example": "node dist/cli.js serve examples/hello/mcpack.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "node test/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.17.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.18.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2"
  }
}
