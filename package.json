{
  "name": "@modern-software/mcpack",
  "version": "0.9.0",
  "description": "Manifest-driven MCP servers with persistent Node and Python workers, stdio and Streamable HTTP",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "mcpack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtimes",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "example": "node dist/cli.js serve examples/hello/mcpack.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "node test/package-smoke.mjs",
    "benchmark": "npm run build && node benchmark/run.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.17.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.18.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ModernSoftware/mcpack.git"
  },
  "homepage": "https://github.com/ModernSoftware/mcpack#readme",
  "bugs": {
    "url": "https://github.com/ModernSoftware/mcpack/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tools",
    "python",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
